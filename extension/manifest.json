{
  "manifest_version": 3,
  "name": "KGP ERP Auto-Login",
  "version": "1.0.0",
  "description": "Automated, secure 1-click login for IIT Kharagpur ERP with Gmail OTP detection.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://erp.iitkgp.ac.in/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/IIT_ERP3/*",
        "https://erp.iitkgp.ac.in/SSOAdministration/*",
        "https://erp.iitkgp.ac.in/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "quick_launch_erp": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Quick launch and auto-login to IIT KGP ERP"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KGP ERP Auto-Login Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "images/*"],
      "matches": ["https://erp.iitkgp.ac.in/*"]
    }
  ]
}
